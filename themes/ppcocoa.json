  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#e6dcf5",
    "property": "#9ab0f0",
    "function": "#9ab0f0",
    "method": "#9ab0f0",
    "class": "#e0c07a",
    "interface": "#e0c07a",
    "type": "#e0c07a",
    "parameter": "#c9b8e8",
    "keyword": "#c3a6f0",
    "string": "#d9b896",
    "number": "#f0a080",
    "comment": "#7a6e95"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7a6e95",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.unquoted"],
      "settings": {
        "foreground": "#d9b896"
      }
    },
    {
      "name": "String Escape / Special",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": {
        "foreground": "#e0c9a6"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#f0a080"
      }
    },
    {
      "name": "Keyword / Storage",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#c3a6f0"
      }
    },
    {
      "name": "Function Name",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#9ab0f0"
      }
    },
    {
      "name": "Class / Type / Interface",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "entity.name.type.class"],
      "settings": {
        "foreground": "#e0c07a"
      }
    },
    {
      "name": "Variable / Parameter",
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#c9b8e8"
      }
    },
    {
      "name": "Constant / Language Constant",
      "scope": ["constant.language", "constant.character", "constant.other", "variable.language"],
      "settings": {
        "foreground": "#f0a0a8"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#8ec9c0"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#9a8ec0"
      }
    },
    {
      "name": "Tag (HTML/XML/JSX)",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#f0a0a8"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#e0c07a"
      }
    },
    {
      "name": "Property / Key",
      "scope": ["support.type.property-name", "meta.property-name", "variable.object.property"],
      "settings": {
        "foreground": "#9ab0f0"
      }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#c3a6f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#e6dcf5"
      }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c9b8e0"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#f2a0b8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff Added",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#7ec8a3"
      }
    },
    {
      "name": "Diff Removed",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#f2a0b8"
      }
    }
  ]
}
