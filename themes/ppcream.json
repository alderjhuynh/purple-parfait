  "semanticHighlighting": true,
  "semanticTokenColors": {
    "variable": "#4a3b5a",
    "property": "#7e9cd8",
    "function": "#7e9cd8",
    "method": "#7e9cd8",
    "class": "#c28a3a",
    "interface": "#c28a3a",
    "type": "#c28a3a",
    "parameter": "#6d4c8a",
    "keyword": "#9b7ec8",
    "string": "#b38a5a",
    "number": "#d47a5a",
    "comment": "#a898b8"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#a898b8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.unquoted"],
      "settings": {
        "foreground": "#b38a5a"
      }
    },
    {
      "name": "String Escape / Special",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": {
        "foreground": "#c49a6c"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#d47a5a"
      }
    },
    {
      "name": "Keyword / Storage",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": {
        "foreground": "#9b7ec8"
      }
    },
    {
      "name": "Function Name",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#7e9cd8"
      }
    },
    {
      "name": "Class / Type / Interface",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "entity.name.type.class"],
      "settings": {
        "foreground": "#c28a3a"
      }
    },
    {
      "name": "Variable / Parameter",
      "scope": ["variable", "variable.parameter", "variable.other"],
      "settings": {
        "foreground": "#6d4c8a"
      }
    },
    {
      "name": "Constant / Language Constant",
      "scope": ["constant.language", "constant.character", "constant.other", "variable.language"],
      "settings": {
        "foreground": "#d67e8a"
      }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#6ab0a6"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator"],
      "settings": {
        "foreground": "#8a7eb0"
      }
    },
    {
      "name": "Tag (HTML/XML/JSX)",
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#d67e8a"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#c28a3a"
      }
    },
    {
      "name": "Property / Key",
      "scope": ["support.type.property-name", "meta.property-name", "variable.object.property"],
      "settings": {
        "foreground": "#7e9cd8"
      }
    },
    {
      "name": "Markup Heading",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#9b7ec8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#6d4c8a"
      }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#8a6ea8"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#e8a0b8",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Diff Added",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#7ec8a3"
      }
    },
    {
      "name": "Diff Removed",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#e8a0b8"
      }
    }
  ]
}
